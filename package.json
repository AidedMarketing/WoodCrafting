{
  "name": "woodcrafting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -b",
    "format": "prettier --write src tests scripts *.json *.md index.html",
    "format:check": "prettier --check src tests scripts *.json *.md index.html",
    "render:assets": "node scripts/render-assets.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.6.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
